{
  "name": "vr-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "launch": "adb shell am start -a android.intent.action.VIEW -d https://clintonium-119.github.io/vr-life/",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs 'http://localhost:4173/vr-life/?world=test&dev=perf,tools&drive=auto' 9",
    "smoke:crowd": "node scripts/smoke.mjs 'http://localhost:4173/vr-life/?world=test&dev=perf,tools,crowd&drive=auto' 9 --max-calls 400",
    "smoke:home": "node scripts/smoke.mjs 'http://localhost:4173/vr-life/?dev=perf,tools&drive=auto' 10 --require 'door crossed'",
    "smoke:town": "for p in bedroom officeRoof hospitalRoof school farm forest; do node scripts/smoke.mjs \"http://localhost:4173/vr-life/?dev=perf,tools&drive=auto&spawn=$p\" 7 --max-calls 400 || exit 1; done",
    "smoke:day": "node scripts/smoke.mjs 'http://localhost:4173/vr-life/?dev=perf,tools&drive=auto' 10 --require 'day: rush' --require 'door crossed'"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "@types/webxr": "^0.5.24",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
